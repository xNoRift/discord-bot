<%- include('partials/head', { title: guild.name + ' – Giveaways' }) %>
<%- include('partials/app-shell-open') %>

<div class="page-head">
  <div class="page-head__row">
    <h1><%- icon('gift') %> Giveaways</h1>
    <button class="btn btn--primary" id="newGiveawayBtn"><%- icon('plus') %> Giveaway erstellen</button>
  </div>
  <p>Erstelle Giveaways, lose neu aus und verwalte die Gewinnerrolle.</p>
</div>

<div class="module-status" id="moduleStatus">
  <span class="module-status__dot"></span>
  <span class="module-status__text"><b id="msTitle">…</b><span id="msText"></span></span>
  <button class="btn btn--ghost btn--sm" id="msToggle">…</button>
</div>

<div class="col-2">
  <div class="card">
    <div class="card__head">
      <h2><%- icon('gift') %> Giveaways</h2>
      <div class="spacer"></div>
      <div class="tabs" id="gwTabs">
        <button class="tab is-active" data-status="active">Aktiv</button>
        <button class="tab" data-status="ended">Vergangen</button>
      </div>
    </div>
    <div id="gwList"><div class="loading">Lädt…</div></div>
  </div>

  <div class="card">
    <div class="card__head"><h2><%- icon('star') %> Aktive Gewinnerrollen</h2></div>
    <p class="card__sub">Temporäre Rollen, die nach Ablauf automatisch entfernt werden – bleibt auch nach Bot-Neustart erhalten.</p>
    <div id="tempRoles"><div class="loading">Lädt…</div></div>
  </div>
</div>

<div class="card">
  <div class="card__head"><h2><%- icon('settings') %> Standard-Einstellungen</h2></div>
  <form id="gwSettings" class="form">
    <div class="col-2">
      <div class="field"><label>Standard-Giveaway-Kanal</label><select name="giveaway_channel_id" data-type="text"></select></div>
      <div class="field"><label>Giveaway-Log-Kanal</label><select name="giveaway_log_channel_id" data-type="text"></select></div>
      <div class="field"><label>🏆 Giveaway-Gewinnerrolle</label><select name="giveaway_winner_role_id" data-type="role"></select></div>
      <div class="field"><label>Dauer der Gewinnerrolle</label><input name="giveaway_winner_role_duration_ms" type="text" placeholder="24h" /><small>z. B. <code>24h</code>, <code>7d</code>. Standard: 24 Stunden.</small></div>
    </div>
    <div class="setting-row">
      <div class="setting-row__text"><b>Ticket-Button bei Gewinn</b><span>Gewinner können sich über einen Button in der Gewinner-Nachricht direkt ein Ticket erstellen, um ihren Preis abzuholen</span></div>
      <label class="toggle"><input type="checkbox" name="giveaway_ticket_button" /><span class="toggle__track"></span></label>
    </div>
    <div id="gwTicketFields">
      <p class="card__sub">Einstellungen für dieses Ticket – genau wie bei den Ticket-Standard-Einstellungen. Leer = allgemeiner Ticket-Standard wird verwendet.</p>
      <div class="col-2">
        <div class="field"><label>Discord-Kategorie</label><select name="giveaway_ticket_category_id" data-type="category"></select></div>
        <div class="field"><label>Support-Rolle</label><select name="giveaway_ticket_support_role_id" data-type="role"></select></div>
      </div>
      <div class="field">
        <label>Kanalname</label>
        <input name="giveaway_ticket_name_format" placeholder="ticket-{user}" maxlength="90" />
        <small>Platzhalter: <code>{user}</code>, <code>{number}</code>.</small>
      </div>
      <div class="field">
        <label>Begrüßung im Ticket</label>
        <textarea name="giveaway_ticket_welcome_message" rows="3" placeholder="Herzlichen Glückwunsch {user}! Ein Team-Mitglied meldet sich gleich, um deinen Gewinn zu übergeben."></textarea>
        <small>Platzhalter: <code>{user}</code>, <code>{number}</code>.</small>
      </div>
    </div>
  </form>
</div>

<style>
  #gwTicketFields { margin-top:10px; padding-top:10px; border-top:1px solid var(--line); transition:opacity .15s; }
  #gwTicketFields.is-off { opacity:.5; pointer-events:none; }
</style>

<%- include('partials/app-shell-close') %>
<script src="/static/js/giveaways.js?v=<%= typeof assetVer !== "undefined" ? assetVer : "1" %>"></script>
<%- include('partials/foot') %>

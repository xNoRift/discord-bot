    <b><%= t('savebar.title') %></b>
    <span><%= t('savebar.hint') %></span>
  </span>
  <button class="savebar__cancel" id="saveBarCancel" type="button" title="<%= t('savebar.discard') %>" aria-label="<%= t('savebar.discard') %>"><%- icon('x', 'icon--sm') %></button>
  <button class="savebar__save" id="saveBarSave" type="button" title="<%= t('common.save') %>" aria-label="<%= t('common.save') %>"><%- icon('check', 'icon--sm') %> <%= t('common.save') %></button>
  <span class="savebar__track"><span></span></span>
</div>

<div class="toast-stack" id="toastStack" aria-live="polite"></div>
<div class="modal-root" id="modalRoot"></div>


<%- include('partials/head', { title: guild.name + ' – Custom Commands' }) %>
<%- include('partials/app-shell-open') %>

<div class="page-head">
  <div class="page-head__row"><h1><%- icon('sparkles') %> Custom Commands</h1></div>
  <p>Eigene Text-/Embed-Befehle mit dem Server-Prefix (<code id="prefixHint">!</code>). Platzhalter: <code>{user}</code> <code>{username}</code> <code>{server}</code> <code>{member_count}</code> <code>{channel}</code> <code>{date}</code></p>
</div>

<div class="card">
  <div class="card__head"><h2><%- icon('plus') %> Neuer Command</h2></div>
  <form id="cmdCreateForm" class="form">
    <div class="col-2">
      <div class="field"><label>Name (ohne Prefix)</label><input name="name" maxlength="32" placeholder="socials" required /></div>
      <div class="field"><label>Antwort-Typ</label>
        <select name="response_type"><option value="text">Text</option><option value="embed">Embed</option></select>
      </div>
    </div>
    <div class="field"><label>Antwort / Beschreibung</label><textarea name="content" rows="3" maxlength="4000" placeholder="Folge uns auf ..."></textarea></div>
    <div><button class="btn btn--primary btn--sm" type="submit"><%- icon('plus', 'icon--sm') %> Erstellen</button> <span class="muted" id="cmdCreateStatus"></span></div>
  </form>
</div>

<div id="cmdListWrap"><div class="loading">Lädt…</div></div>

<%- include('partials/app-shell-close') %>
<script src="/static/js/commands.js?v=<%= typeof assetVer !== "undefined" ? assetVer : "1" %>"></script>
<%- include('partials/foot') %>

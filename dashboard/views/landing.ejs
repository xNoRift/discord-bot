<%- include('partials/head', { title: brandName }) %>

<div class="auth">
  <div class="auth__card">
    <span class="auth__logo"><%- icon('bot') %></span>
    <h1><%= brandName %></h1>
    <p class="auth__lead"><%= t('landing.lead') %></p>

    <div class="auth__features">
      <div class="auth__feature"><%- icon('ticket') %><strong><%= t('landing.f_tickets') %></strong><span><%= t('landing.f_tickets_sub') %></span></div>
      <div class="auth__feature"><%- icon('gift') %><strong><%= t('landing.f_giveaways') %></strong><span><%= t('landing.f_giveaways_sub') %></span></div>
      <div class="auth__feature"><%- icon('clipboard') %><strong><%= t('landing.f_applications') %></strong><span><%= t('landing.f_applications_sub') %></span></div>
      <div class="auth__feature"><%- icon('shield') %><strong><%= t('landing.f_secure') %></strong><span><%= t('landing.f_secure_sub') %></span></div>
    </div>

    <a class="btn btn--primary btn--lg" href="/auth/discord"><%- icon('bot') %> <%= t('landing.login') %></a>
    <p class="auth__hint"><%= t('landing.hint') %></p>
  </div>
</div>

<%- include('partials/foot') %>

<%- include('partials/head', { title: guild.name + ' – Rollen-Panels' }) %>
<%- include('partials/app-shell-open') %>

<div class="page-head">
  <div class="page-head__row"><h1><%- icon('sparkles') %> Rollen-Panels</h1></div>
  <p>Button- oder Auswahlmenü-Nachrichten, über die Mitglieder sich selbst Rollen geben können. Mehrere Panels pro Server möglich.</p>
</div>

<div class="card">
  <div class="card__head"><h2><%- icon('plus') %> Neues Panel</h2></div>
  <form id="panelCreateForm" class="form">
    <div class="field"><label>Interner Name</label><input name="name" maxlength="80" placeholder="z. B. Pronomen-Rollen" required /></div>
    <div><button class="btn btn--primary btn--sm" type="submit"><%- icon('plus', 'icon--sm') %> Erstellen</button> <span class="muted" id="panelCreateStatus"></span></div>
  </form>
</div>

<div id="panelListWrap"><div class="loading">Lädt…</div></div>

<%- include('partials/app-shell-close') %>
<script src="/static/js/rolepanels.js?v=<%= typeof assetVer !== "undefined" ? assetVer : "1" %>"></script>
<%- include('partials/foot') %>

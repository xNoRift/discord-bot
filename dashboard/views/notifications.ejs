<%- include('partials/head', { title: guild.name + ' – Benachrichtigungen' }) %>
<%- include('partials/app-shell-open') %>

<div class="page-head">
  <div class="page-head__row"><h1><%- icon('bell') %> Benachrichtigungen</h1></div>
  <p>Lege pro Ereignis fest, wohin die Meldung geht: in einen Discord-Kanal und/oder ins Dashboard-Postfach. Ist ein Ereignis hier nicht konfiguriert, greift der normale Log-Kanal wie bisher.</p>
</div>

<div class="card">
  <div class="card__head"><h2><%- icon('settings') %> Ereignisse</h2></div>
  <div id="notifConfig"><div class="loading">Lädt…</div></div>
</div>

<div class="card">
  <div class="card__head">
    <h2><%- icon('bell') %> Postfach <span class="muted" id="notifUnread"></span></h2>
    <div class="spacer"></div>
    <button class="btn btn--ghost btn--sm" type="button" id="notifReadAll">Alle als gelesen markieren</button>
  </div>
  <ul class="activity" id="notifInbox"><li class="loading">Lädt…</li></ul>
</div>

<%- include('partials/app-shell-close') %>
<script src="/static/js/notifications.js?v=<%= typeof assetVer !== "undefined" ? assetVer : "1" %>"></script>
<%- include('partials/foot') %>

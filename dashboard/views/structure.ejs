<%- include('partials/head', { title: guild.name + ' – Server-Struktur' }) %>
<%- include('partials/app-shell-open') %>

<div class="page-head">
  <div class="page-head__row"><h1><%- icon('layers') %> Server-Struktur <span class="muted">(nur Besitzer)</span></h1></div>
  <p>Nur für dich als Bot-Besitzer: Kanäle und Kategorien erstellen und die Reihenfolge der Rollen ändern.</p>
</div>

<div class="card" id="permWarn" hidden>
  <div class="card__head"><h2><%- icon('shield') %> Eingeschränkt</h2></div>
  <p class="card__sub" id="permWarnText"></p>
</div>

<div class="card">
  <div class="card__head"><h2><%- icon('plus') %> Kanal / Kategorie erstellen</h2></div>
  <form id="chForm">
    <div class="col-2">
      <div class="field">
        <label>Typ</label>
        <select id="chType">
          <option value="text">Textkanal</option>
          <option value="voice">Sprachkanal</option>
          <option value="category">Kategorie</option>
          <option value="announcement">Ankündigungskanal</option>
          <option value="stage">Bühnenkanal</option>
        </select>
      </div>
      <div class="field"><label>Name</label><input id="chName" maxlength="100" placeholder="z. B. ankündigungen" required /></div>
    </div>
    <div class="field" id="chParentField">
      <label>In Kategorie</label>
      <select id="chParent"><option value="">— keine —</option></select>
    </div>
    <div style="margin-top:12px;"><button class="btn btn--primary btn--sm" type="submit"><%- icon('plus', 'icon--sm') %> Erstellen</button> <span class="muted" id="chMsg"></span></div>
  </form>
</div>

<div class="card">
  <div class="card__head"><h2><%- icon('shield') %> Rollen-Reihenfolge</h2></div>
  <p class="card__sub">Oben = höher in der Rangordnung. Der Bot kann nur Rollen <strong>unter</strong> seiner eigenen höchsten Rolle verschieben – die anderen sind ausgegraut.</p>
  <div id="roleOrder"><div class="loading">Lädt…</div></div>
  <div style="margin-top:12px;"><button class="btn btn--primary btn--sm" id="roleOrderSave" disabled><%- icon('check', 'icon--sm') %> Reihenfolge speichern</button> <span class="muted" id="roMsg"></span></div>
</div>

<style>
  .ro-item { display:flex; align-items:center; gap:10px; padding:8px 6px; border-bottom:1px solid var(--line); }
  .ro-item:last-child { border-bottom:0; }
  .ro-item.is-locked { opacity:.45; }
  .ro-item__dot { width:11px; height:11px; border-radius:50%; flex:none; }
  .ro-item__name { flex:1; }
  .ro-item__btns { display:flex; gap:4px; }
  .ro-item__btns button { width:30px; height:28px; padding:0; }
  .ro-lockicon { font-size:.75rem; color:var(--muted); }
</style>

<%- include('partials/app-shell-close') %>
<script src="/static/js/structure.js?v=<%= typeof assetVer !== "undefined" ? assetVer : "1" %>"></script>
<%- include('partials/foot') %>

<%- include('partials/head', { title: t('servers.title') + ' – ' + brandName }) %>
<%- include('partials/app-shell-open') %>

<div class="page-head">
  <div class="page-head__row">
    <h1><%- icon('server') %> <%= t('servers.title') %></h1>
    <button class="btn btn--ghost btn--sm" id="refreshGuilds"><%- icon('refresh') %> <%= t('servers.refresh') %></button>
  </div>
  <p><%= t('servers.lead') %></p>
</div>

<div class="field" style="max-width:420px;margin-bottom:16px;">
  <input id="guildSearch" type="search" placeholder="<%= t('servers.search') %>" autocomplete="off" />
</div>

<div class="card">
  <div class="card__head"><h2><%- icon('check') %> <%= t('servers.available') %></h2></div>
  <div class="grid-cards" id="managedGuilds"><div class="loading"><%= t('servers.loading') %></div></div>
</div>

<div class="card" id="invitableCard" hidden>
  <div class="card__head"><h2><%- icon('plus') %> <%= t('servers.not_invited_title') %></h2></div>
  <p class="card__sub"><%= t('servers.not_invited_sub') %></p>
  <div class="grid-cards" id="invitableGuilds"></div>
</div>

<script type="application/json" id="pageData">{ "clientId": "<%= clientId %>", "invitePermissions": "<%= invitePermissions %>" }</script>
<%- include('partials/app-shell-close') %>
<script src="/static/js/servers.js?v=<%= typeof assetVer !== "undefined" ? assetVer : "1" %>"></script>
<%- include('partials/foot') %>

<%- include('partials/head', { title: guild.name + ' – Einstellungen' }) %>
<%- include('partials/app-shell-open') %>

<div class="page-head">
  <div class="page-head__row"><h1><%- icon('settings') %> Einstellungen</h1></div>
  <p>Diese Einstellungen gelten nur für <strong><%= guild.name %></strong>.</p>
</div>

<div class="card">
  <div class="card__head"><h2><%- icon('bot') %> Bot auf diesem Server</h2></div>
  <p class="card__sub">Ändert nur den Namen und das Bild des Bots <strong>auf <%= guild.name %></strong> – der eigentliche Bot-Account bleibt unverändert.</p>
  <div class="row-inline" style="align-items:flex-start;gap:18px;flex-wrap:wrap;">
    <div style="text-align:center;">
      <img id="botAvatar" class="server-icon" style="width:88px;height:88px;border-radius:24px;" alt="" />
      <div style="margin-top:8px;display:flex;gap:6px;justify-content:center;">
        <label class="btn btn--ghost btn--sm" style="cursor:pointer;">
          <%- icon('edit', 'icon--sm') %> Bild
          <input type="file" id="botAvatarFile" accept="image/png,image/jpeg,image/gif,image/webp" hidden />
        </label>
        <button class="btn btn--ghost btn--sm" id="botAvatarReset" type="button">Zurücksetzen</button>
      </div>
    </div>
    <div class="field" style="flex:1;min-width:220px;">
      <label>Anzeigename auf diesem Server (Nickname)</label>
      <div class="field-hint">Max. 32 Zeichen. Leer lassen = Standard-Bot-Name. Der Bot braucht das Recht „Nickname ändern".</div>
      <div class="row-inline">
        <input id="botNick" type="text" maxlength="32" placeholder="NoRift Bot" />
        <button class="btn btn--primary btn--sm" id="botNickSave" type="button">Speichern</button>
      </div>
      <p class="muted" id="botProfileStatus"></p>
    </div>
  </div>
</div>

<div class="card">
  <div class="card__head"><h2><%- icon('bot') %> Bot-Status <span class="muted">(gilt bot-weit)</span></h2></div>
  <div class="form">
    <div class="field">
      <label>Status</label>
      <select id="psStatus">
        <option value="online">🟢 Online</option>
        <option value="idle">🌙 Abwesend</option>
        <option value="dnd">⛔ Bitte nicht stören</option>
        <option value="invisible">⚪ Unsichtbar</option>
      </select>
    </div>
    <div class="col-2">
      <div class="field">
        <label>Aktivität</label>
        <select id="psType">
          <option value="none">— keine —</option>
          <option value="playing">Spielt …</option>
          <option value="watching">Schaut … zu</option>
          <option value="listening">Hört … zu</option>
          <option value="competing">Tritt an in …</option>
          <option value="streaming">Streamt …</option>
          <option value="custom">Benutzerdefiniert</option>
        </select>
      </div>
      <div class="field">
        <label>Text</label>
        <input id="psText" type="text" maxlength="128" placeholder="/help • Dashboard" />
      </div>
    </div>
    <div class="field" id="psUrlWrap" hidden>
      <label>Stream-Link (Twitch / YouTube)</label>
      <input id="psUrl" type="url" maxlength="300" placeholder="https://twitch.tv/deinname" />
    </div>
    <div><button class="btn btn--primary btn--sm" id="psSave" type="button">Status speichern</button> <span class="muted" id="psStatusMsg"></span></div>
  </div>
</div>

<form id="settingsForm">
  <div class="card">
    <div class="card__head"><h2><%- icon('settings') %> Allgemein</h2></div>
    <div class="col-2">
      <div class="field"><label>Embed-Farbe</label>
        <div class="row-inline">
          <input type="color" id="ec" style="max-width:70px;" />
          <input name="embed_color" id="ect" placeholder="#7c5cff (leer = Standard)" />
        </div>
      </div>
      <div class="field"><label>Zeitzone</label>
        <select name="timezone">
          <option value="Europe/Berlin">Europe/Berlin</option>
          <option value="Europe/London">Europe/London</option>
          <option value="Europe/Vienna">Europe/Vienna</option>
          <option value="Europe/Zurich">Europe/Zurich</option>
          <option value="America/New_York">America/New_York</option>
          <option value="UTC">UTC</option>
        </select>
      </div>
      <div class="field"><label>Bot-Sprache</label>
        <select name="bot_language"><option value="de">Deutsch</option><option value="en">English</option></select>
      </div>
      <div class="field"><label>Allgemeiner Log-Kanal</label><select name="log_channel_id" data-type="text"></select></div>
    </div>
  </div>

  <div class="col-2">
    <div class="card">
      <div class="card__head"><h2><%- icon('ticket') %> Tickets</h2></div>
      <div class="field"><label>Standard Discord-Kategorie</label><select name="ticket_category_id" data-type="category"></select></div>
      <div class="field"><label>Standard Support-Rolle</label><select name="ticket_support_role_id" data-type="role"></select></div>
      <div class="field"><label>Ticket-Log-Kanal</label><select name="ticket_log_channel_id" data-type="text"></select></div>
    </div>
    <div class="card">
      <div class="card__head"><h2><%- icon('gift') %> Giveaways</h2></div>
      <div class="field"><label>Giveaway-Kanal</label><select name="giveaway_channel_id" data-type="text"></select></div>
      <div class="field"><label>Gewinnerrolle</label><select name="giveaway_winner_role_id" data-type="role"></select></div>
      <div class="field"><label>Dauer der Gewinnerrolle</label><input name="giveaway_winner_role_duration_ms" type="text" placeholder="24h" /></div>
      <div class="field"><label>Giveaway-Log-Kanal</label><select name="giveaway_log_channel_id" data-type="text"></select></div>
    </div>
  </div>

  <div class="card">
    <div class="card__head"><h2><%- icon('clipboard') %> Bewerbungen &amp; Moderation</h2></div>
    <div class="col-2">
      <div class="field"><label>Bewerbungs-Kanal</label><select name="application_channel_id" data-type="text"></select></div>
      <div class="field"><label>Bewerbungs-Team-Rolle</label><select name="application_team_role_id" data-type="role"></select></div>
      <div class="field"><label>Bewerbungs-Log-Kanal</label><select name="application_log_channel_id" data-type="text"></select></div>
      <div class="field"><label>Moderations-Log-Kanal</label><select name="mod_log_channel_id" data-type="text"></select></div>
    </div>
  </div>

  <div class="form-actions">
    <button class="btn btn--primary" type="submit"><%- icon('check') %> Alle Einstellungen speichern</button>
    <span class="muted" id="sStatus"></span>
  </div>
</form>

<div class="card">
  <div class="card__head"><h2><%- icon('users') %> Auto-Rolle</h2></div>
  <p class="card__sub">Neue Mitglieder bekommen diese Rolle(n) automatisch beim Beitritt. Benötigt den „Server Members"-Intent.</p>
  <div class="field">
    <label>Rollen für neue Mitglieder</label>
    <div id="autoRoleChecks"><div class="loading">Lädt…</div></div>
  </div>
  <details style="margin-top:10px;">
    <summary class="text-2" style="cursor:pointer;">Eigene Rollen für Bots (optional)</summary>
    <div id="autoRoleBotChecks" style="margin-top:8px;"></div>
  </details>
  <div class="row-inline" style="margin-top:14px;flex-wrap:wrap;">
    <button class="btn btn--primary btn--sm" id="autoRoleSave" type="button">Speichern</button>
    <button class="btn btn--ghost btn--sm" id="autoRoleApplyAll" type="button"><%- icon('refresh', 'icon--sm') %> Jetzt an alle vergeben</button>
    <span class="muted" id="autoRoleStatus"></span>
  </div>
</div>

<%- include('partials/app-shell-close') %>
<script src="/static/js/settings.js?v=<%= typeof assetVer !== "undefined" ? assetVer : "1" %>"></script>
<%- include('partials/foot') %>

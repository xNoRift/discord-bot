<%- include('partials/head', { title: guild.name + ' – Logs' }) %>
<%- include('partials/app-shell-open') %>

<div class="page-head">
  <div class="page-head__row">
    <h1><%- icon('file') %> Logs</h1>
    <button class="btn btn--ghost btn--sm" id="reload"><%- icon('refresh') %> Aktualisieren</button>
  </div>
  <p>Alle Aktionen des Bots auf diesem Server.</p>
</div>

<div class="card">
  <div class="card__head">
    <h2><%- icon('bell') %> Verlauf</h2>
    <div class="spacer"></div>
    <div class="tabs tabs--wrap" id="logTabs">
      <button class="tab is-active" data-f="">Alle</button>
      <button class="tab" data-f="ticket">Tickets</button>
      <button class="tab" data-f="giveaway">Giveaways</button>
      <button class="tab" data-f="application">Bewerbungen</button>
    </div>
  </div>
  <ul class="activity" id="logList"><li class="loading">Lädt…</li></ul>
</div>

<div class="card">
  <div class="card__head"><h2><%- icon('settings') %> Allgemeiner Log-Kanal</h2></div>
  <p class="card__sub">Fallback für alles, was keinen eigenen Log-Kanal hat. Eigene Log-Kanäle stellst du direkt beim Modul ein (Tickets, Giveaways, Bewerbungen, Moderation, Guild Protection).</p>
  <form id="logChannels" class="form">
    <div class="field" style="max-width:420px;"><label>Allgemeiner Log-Kanal</label><select name="log_channel_id" data-type="text"></select></div>
  </form>
</div>

<%- include('partials/app-shell-close') %>
<script src="/static/js/logs.js?v=<%= typeof assetVer !== "undefined" ? assetVer : "1" %>"></script>
<%- include('partials/foot') %>

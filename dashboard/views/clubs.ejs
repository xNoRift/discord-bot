<%- include('partials/head', { title: guild.name + ' – Club-Management' }) %>
<%- include('partials/app-shell-open') %>

<div class="page-head">
  <div class="page-head__row">
    <h1><%- icon('users') %> Club-Management</h1>
    <button class="btn btn--primary" id="newClubBtn" type="button"><%- icon('plus') %> Club erstellen</button>
  </div>
  <p>Verwalte Clubs, Gilden oder Teams deines Servers – mit Leiter, Rängen und auf Wunsch eigener Rolle und privatem Kanal.</p>
</div>

<div class="module-status" id="moduleStatus">
  <span class="module-status__dot"></span>
  <span class="module-status__text"><b id="msTitle">…</b><span id="msText"></span></span>
  <button class="btn btn--ghost btn--sm" id="msToggle">…</button>
</div>

<form id="clubSettings" class="card">
  <div class="card__head"><h2><%- icon('settings') %> Einstellungen</h2></div>
  <div class="setting-row">
    <div class="setting-row__text"><b>Rolle pro Club erstellen</b><span>Mitglieder bekommen automatisch die Club-Rolle</span></div>
    <label class="toggle"><input type="checkbox" name="createRole" /><span class="toggle__track"></span></label>
  </div>
  <div class="setting-row">
    <div class="setting-row__text"><b>Privaten Kanal pro Club erstellen</b><span>Nur für die Club-Rolle sichtbar (benötigt die Rollen-Option)</span></div>
    <label class="toggle"><input type="checkbox" name="createChannel" /><span class="toggle__track"></span></label>
  </div>
  <div class="col-2">
    <div class="field"><label>Kategorie für Club-Kanäle</label><select name="categoryId" data-type="category"></select></div>
    <div class="field"><label>Max. Clubs pro Leiter</label><input name="maxClubsPerUser" type="number" min="1" max="10" /></div>
  </div>
</form>

<div id="clubList"><div class="loading">Lädt…</div></div>

<%- include('partials/app-shell-close') %>
<script src="/static/js/clubs.js?v=<%= typeof assetVer !== "undefined" ? assetVer : "1" %>"></script>
<%- include('partials/foot') %>

<%- include('partials/head', { title: guild.name + ' – Willkommen' }) %>
<%- include('partials/app-shell-open') %>

<div class="page-head">
  <div class="page-head__row"><h1><%- icon('bell') %> Willkommens-System</h1></div>
  <p>Begrüße neue Mitglieder auf <strong><%= guild.name %></strong> automatisch und vergib ihnen eine Rolle.</p>
</div>

<div class="module-status" id="moduleStatus">
  <span class="module-status__dot"></span>
  <span class="module-status__text"><b id="msTitle">…</b><span id="msText"></span></span>
  <button class="btn btn--ghost btn--sm" id="msToggle">…</button>
</div>

<form id="welcomeForm">
  <div class="card">
    <div class="card__head"><h2><%- icon('chat') %> Willkommensnachricht</h2></div>
    <div class="field"><label>Kanal</label><select name="welcome_channel_id" data-type="text"></select></div>

    <div class="field">
      <label>Text</label>
      <textarea name="welcome_message" rows="4" placeholder="Willkommen auf {server}, {user}!" data-emoji></textarea>
      <div class="field-hint">
        Platzhalter:
        <code>{user}</code> (Erwähnung) ·
        <code>{username}</code> ·
        <code>{user.tag}</code> ·
        <code>{server}</code> ·
        <code>{membercount}</code>
      </div>
    </div>

    <div class="col-2">
      <div class="setting-row">
        <div class="setting-row__text"><b>Als Embed</b><span>Farbige Box mit Profilbild des Mitglieds</span></div>
        <label class="toggle"><input type="checkbox" name="welcome_embed" /><span class="toggle__track"></span></label>
      </div>
      <div class="setting-row">
        <div class="setting-row__text"><b>Mitglied anpingen</b><span>Löst eine Benachrichtigung beim neuen Mitglied aus</span></div>
        <label class="toggle"><input type="checkbox" name="welcome_ping" /><span class="toggle__track"></span></label>
      </div>
    </div>

    <div class="field" style="max-width:220px;">
      <label>Embed-Farbe</label>
      <div class="row-inline">
        <input type="color" id="wcColor" value="#7c5cff" style="max-width:70px;" />
        <input name="welcome_color" id="wcColorText" type="text" placeholder="#7c5cff" maxlength="7" />
      </div>
    </div>

    <details class="embed-editor" style="margin-top:14px;" open>
      <summary class="text-2" style="cursor:pointer;"><b>Embed-Editor</b> – Aussehen der Willkommens-Box</summary>
      <div class="col-2" style="margin-top:10px;">
        <div class="field"><label>Titel</label><input name="joinTitle" maxlength="256" placeholder="z. B. Willkommen, {username}!" data-emoji /></div>
        <div class="field"><label>Fußzeile</label><input name="joinFooter" maxlength="256" placeholder="z. B. Du bist Mitglied Nr. {membercount}" data-emoji /></div>
      </div>
      <div class="field"><label>Großes Bild (URL)</label><input name="joinImageUrl" maxlength="500" placeholder="https://…/banner.png" /><small>Nur https-Links. Leer = kein Bild.</small></div>
      <div class="setting-row"><div class="setting-row__text"><b>Profilbild als Thumbnail</b><span>Zeigt das Profilbild des Mitglieds rechts oben</span></div><label class="toggle"><input type="checkbox" name="joinThumbnail" /><span class="toggle__track"></span></label></div>
      <div class="setting-row"><div class="setting-row__text"><b>Mitgliedsname als Autor</b><span>Name und Profilbild über dem Text</span></div><label class="toggle"><input type="checkbox" name="joinAuthor" /><span class="toggle__track"></span></label></div>
      <div class="setting-row"><div class="setting-row__text"><b>Zeitstempel</b><span>Zeigt Datum und Uhrzeit unten in der Box</span></div><label class="toggle"><input type="checkbox" name="joinTimestamp" /><span class="toggle__track"></span></label></div>
      <div class="field"><label>Vorschau</label><div class="embed-preview" id="wcPreview"></div></div>
    </details>
  </div>

  <div class="card">
    <div class="card__head"><h2><%- icon('users') %> Rolle beim Beitritt <span class="muted">(Auto-Rolle)</span></h2></div>
    <p class="card__sub">Neue Mitglieder bekommen diese Rolle(n) automatisch. Der Bot braucht „Rollen verwalten" und muss <b>über</b> der Rolle stehen. (Benötigt den „Server Members"-Intent.)</p>
    <div class="field">
      <label>Rollen für neue Mitglieder</label>
      <div id="joinRoleChecks" style="display:flex;flex-wrap:wrap;gap:8px;"><div class="loading">Lädt…</div></div>
    </div>
    <details style="margin-top:10px;">
      <summary class="text-2" style="cursor:pointer;">Eigene Rollen für Bots (optional)</summary>
      <div id="joinRoleBotChecks" style="margin-top:8px;display:flex;flex-wrap:wrap;gap:8px;"></div>
    </details>
    <div class="row-inline" style="margin-top:14px;flex-wrap:wrap;">
      <button class="btn btn--ghost btn--sm" type="button" id="joinRoleApplyAll"><%- icon('refresh', 'icon--sm') %> Jetzt an alle aktuellen Mitglieder vergeben</button>
      <span class="muted" id="joinRoleStatus"></span>
    </div>
  </div>

  <div class="card">
    <div class="card__head"><h2><%- icon('send') %> Willkommens-DM (optional)</h2></div>
    <div class="setting-row">
      <div class="setting-row__text"><b>Private Nachricht senden</b><span>Der Bot schreibt dem neuen Mitglied direkt (wenn dessen DMs offen sind)</span></div>
      <label class="toggle"><input type="checkbox" name="welcome_dm_enabled" /><span class="toggle__track"></span></label>
    </div>
    <div class="field">
      <label>DM-Text</label>
      <textarea name="welcome_dm_message" rows="3" placeholder="Hey {username}, schön dass du auf {server} bist!" data-emoji></textarea>
    </div>
  </div>

  <div class="card">
    <div class="card__head"><h2><%- icon('logout') %> Abschiedsnachricht (optional)</h2></div>
    <div class="setting-row">
      <div class="setting-row__text"><b>Abschiedsnachricht aktivieren</b><span>Postet eine kurze Nachricht, wenn jemand den Server verlässt</span></div>
      <label class="toggle"><input type="checkbox" name="leave_enabled" /><span class="toggle__track"></span></label>
    </div>
    <div class="field"><label>Kanal</label><select name="leave_channel_id" data-type="text"></select></div>
    <div class="field">
      <label>Text</label>
      <textarea name="leave_message" rows="2" placeholder="{username} hat den Server verlassen." data-emoji></textarea>
    </div>
    <details class="embed-editor" style="margin-top:10px;">
      <summary class="text-2" style="cursor:pointer;"><b>Embed-Editor</b> – Aussehen der Abschieds-Box</summary>
      <div class="setting-row"><div class="setting-row__text"><b>Als Embed senden</b><span>Farbige Box statt einfachem Text</span></div><label class="toggle"><input type="checkbox" name="leaveEmbed" /><span class="toggle__track"></span></label></div>
      <div class="col-2" style="margin-top:10px;">
        <div class="field"><label>Titel</label><input name="leaveTitle" maxlength="256" placeholder="z. B. Auf Wiedersehen" data-emoji /></div>
        <div class="field"><label>Fußzeile</label><input name="leaveFooter" maxlength="256" placeholder="z. B. Wir sind jetzt {membercount}" data-emoji /></div>
      </div>
      <div class="field" style="max-width:220px;"><label>Farbe</label><div class="row-inline"><input type="color" id="lvColor" value="#7c5cff" style="max-width:70px;" /><input name="leaveColor" id="lvColorText" maxlength="7" placeholder="#7c5cff" /></div></div>
      <div class="setting-row"><div class="setting-row__text"><b>Profilbild als Thumbnail</b></div><label class="toggle"><input type="checkbox" name="leaveThumbnail" /><span class="toggle__track"></span></label></div>
      <div class="setting-row"><div class="setting-row__text"><b>Zeitstempel</b></div><label class="toggle"><input type="checkbox" name="leaveTimestamp" /><span class="toggle__track"></span></label></div>
    </details>
  </div>

  <div class="form-actions">
    <button class="btn btn--ghost btn--sm" type="button" id="wcTestLeave"><%- icon('send', 'icon--sm') %> Abschieds-Test senden</button>
    <button class="btn btn--ghost btn--sm" type="button" id="wcTest"><%- icon('send', 'icon--sm') %> Testnachricht senden</button>
    <span class="muted" id="wcStatus"></span>
  </div>
</form>

<%- include('partials/app-shell-close') %>
<script src="/static/js/welcome.js?v=<%= typeof assetVer !== "undefined" ? assetVer : "1" %>"></script>
<%- include('partials/foot') %>

# ============================================================
#  DISCORD BOT V1 - Konfiguration
#  Kopiere diese Datei zu ".env" und fuelle die Werte aus.
#  Die .env-Datei niemals ins Git-Repository committen!
# ============================================================

# --- Discord Bot ---
# Bot-Token aus dem Discord Developer Portal -> Bot -> "Reset Token"
DISCORD_TOKEN=

# Application (Client) ID   -> Developer Portal -> General Information -> Application ID
CLIENT_ID=

# Client Secret            -> Developer Portal -> OAuth2 -> Client Secret ("Reset Secret")
CLIENT_SECRET=

# Optional: Nur fuer diese eine Guild werden Slash-Commands sofort registriert (Entwicklung).
# Leer lassen, um global zu deployen (kann bis zu 1 Stunde dauern).
DEV_GUILD_ID=

# --- Privilegierte Gateway-Intents ---
# Diese muessen im Developer Portal -> Bot -> "Privileged Gateway Intents" aktiviert sein.
# Wenn ein Intent dort (noch) NICHT aktiviert ist, hier auf 0/false setzen,
# sonst startet der Bot nicht ("Used disallowed intents").
#   GuildMembers   -> Auto-Rolle, Willkommens-System, "Aktion beim Verlassen"
#   MessageContent -> Zaehl-Spiel / Mini-Spiele
INTENT_GUILD_MEMBERS=true
INTENT_MESSAGE_CONTENT=true

# --- Datenbank ---
# Pfad zur SQLite-Datei (wird automatisch erstellt).
DATABASE_URL=./data/database.sqlite

# --- Web-Dashboard ---
# Vollstaendige oeffentliche URL des Dashboards (ohne Slash am Ende).
DASHBOARD_URL=http://localhost:3000

# Port, auf dem das Dashboard laeuft.
PORT=3000

# OAuth2 Redirect-URL. Muss EXAKT so im Developer Portal -> OAuth2 -> Redirects eingetragen sein.
OAUTH_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Langer, zufaelliger String zum Signieren der Sessions.
# Erzeugen z.B. mit:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Auf "true" setzen, wenn das Dashboard hinter HTTPS laeuft (Produktion).
SECURE_COOKIES=false

# --- Sicherheit / Besitzer ---
# Deine Discord-User-ID (mehrere mit Komma). Diese Accounts sind "Bot-Besitzer":
#  - sehen/aendern den globalen Bot-Status
#  - sehen das Login-Protokoll unter Einstellungen -> Sicherheit
#  - haben vollen Dashboard-Zugriff
# Eigene ID herausfinden: Discord -> Einstellungen -> Erweitert -> Entwicklermodus an,
# dann Rechtsklick auf dein Profil -> "Benutzer-ID kopieren".
BOT_OWNER_IDS=

# Wenn "true": NUR die oben genannten Besitzer duerfen sich ueberhaupt einloggen.
# Empfohlen, wenn das Dashboard oeffentlich erreichbar ist (z.B. per Server-IP).
DASHBOARD_OWNER_ONLY=false

# Node-Umgebung
NODE_ENV=development

# Anzeigename im Dashboard (Sidebar, Seitentitel, Embeds)
BRAND_NAME=NoRift
